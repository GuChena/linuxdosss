# ============================================================================
# Linux.do 自动刷帖 Docker 配置模板
# ============================================================================
# 使用方法：
#   1. 复制此文件为 .env
#      cp .env.example .env
#   2. 在服务器上编辑 .env，填入 LINUXDO_USERNAME / LINUXDO_PASSWORD
#      nano .env
#   3. 启动
#      docker compose up -d --build
#
# 注意：.env 包含账号密码，不要提交到 GitHub。
# ============================================================================

# ---------------------------------------------------------------------------
# 必填：Linux.do 账号（这里留空，服务器拉取后再填）
# ---------------------------------------------------------------------------
LINUXDO_USERNAME=
LINUXDO_PASSWORD=

# ---------------------------------------------------------------------------
# 推荐保守任务配置
# ---------------------------------------------------------------------------

# 每天运行次数；建议 1 起步，稳定后最多 2。
RUNS_PER_DAY=1

# 每次浏览帖子数随机范围；建议先保守，避免过于规律或过量。
TOPICS_MIN=8
TOPICS_MAX=18

# 点赞概率，范围 0-100；建议 0-10，长期无人值守不建议太高。
LIKE_RATE=0

# 容器启动后是否立刻跑一次；false 表示只等随机定时任务。
RUN_ON_START=true

# ---------------------------------------------------------------------------
# 容器 / 运行环境配置
# ---------------------------------------------------------------------------

# 容器名称。
CONTAINER_NAME=linuxdo-bot

# 时区；保持 Asia/Shanghai 即可。
TZ=Asia/Shanghai

# Chrome 用户数据目录；默认会挂载到 Docker volume，用于保持登录状态。
CHROME_USER_DATA=/app/chrome-data

# 资源限制；NAS/小服务器可以保持默认。
MEMORY_LIMIT=1G
CPU_LIMIT=1.0

# ---------------------------------------------------------------------------
# 手动登录 / 滑块验证配置（仅 docker-compose.manual.yml 使用）
# ---------------------------------------------------------------------------

# 手动登录容器名称。
MANUAL_CONTAINER_NAME=linuxdo-manual-login

# noVNC 访问地址。默认只监听服务器本机，建议用 SSH 隧道访问。
# 如需直接通过 http://服务器IP:6080 访问，可改为 0.0.0.0（注意安全）。
NOVNC_BIND=127.0.0.1
NOVNC_PORT=6080

# 手动登录时打开的地址。
MANUAL_LOGIN_URL=https://linux.do/login

# 手动浏览器窗口大小。
SCREEN_WIDTH=1280
SCREEN_HEIGHT=800

# 手动登录容器共享内存大小。
SHM_SIZE=1gb

# ---------------------------------------------------------------------------
# 调试配置
# ---------------------------------------------------------------------------

# 开启后日志更详细；正常运行建议留空。
DEBUG=
