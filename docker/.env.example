# ============================================================================
# Linux.do 自动刷帖 Docker 配置模板
# ============================================================================
# 使用方法：
#   1. 复制此文件为 .env
#      cp .env.example .env
#   2. 在服务器上编辑 .env，填入 LINUXDO_USERNAME / LINUXDO_PASSWORD
#      nano .env
#   3. 启动
#      docker compose up -d --build
#
# 注意：.env 包含账号密码，不要提交到 GitHub。
# ============================================================================

# ---------------------------------------------------------------------------
# 必填：Linux.do 账号（这里留空，服务器拉取后再填）
# ---------------------------------------------------------------------------
LINUXDO_USERNAME=
LINUXDO_PASSWORD=

# ---------------------------------------------------------------------------
# 运行模式配置
# ---------------------------------------------------------------------------

# 运行模式：endless=无尽模式，schedule=定时任务，once=只运行一次。
RUN_MODE=endless

# 浏览模式：deep=深度爬楼，quick=轻度速览。
BROWSE_MODE=deep

# 是否启用自动点赞/自动回复。Docker 版暂不支持回复，建议保持 false。
ENABLE_LIKE=false
ENABLE_REPLY=false

# 点赞概率，范围 0-100；ENABLE_LIKE=false 时不会点赞。
LIKE_RATE=0

# 容器启动后是否立刻跑一次；仅 schedule 模式使用。
RUN_ON_START=true

# ---------------------------------------------------------------------------
# 定时 / 单次模式配置（RUN_MODE=schedule 或 RUN_MODE=once 时使用）
# ---------------------------------------------------------------------------

# 每天运行次数；仅 schedule 模式使用。
RUNS_PER_DAY=1

# 每次浏览帖子数随机范围；schedule/once 模式使用。
TOPICS_MIN=8
TOPICS_MAX=18

# ---------------------------------------------------------------------------
# 容器 / 运行环境配置
# ---------------------------------------------------------------------------

# 容器名称。
CONTAINER_NAME=linuxdo-bot

# 时区；保持 Asia/Shanghai 即可。
TZ=Asia/Shanghai

# Chrome 用户数据目录；默认会挂载到 Docker volume，用于保持登录状态。
CHROME_USER_DATA=/app/chrome-data

# 资源限制；NAS/小服务器可以保持默认。
MEMORY_LIMIT=1G
CPU_LIMIT=1.0

# ---------------------------------------------------------------------------
# 手动登录 / 滑块验证配置（仅 docker-compose.manual.yml 使用）
# ---------------------------------------------------------------------------

# 手动登录容器名称。
MANUAL_CONTAINER_NAME=linuxdo-manual-login

# noVNC 访问地址。默认只监听服务器本机，建议用 SSH 隧道访问。
# 如需直接通过 http://服务器IP:6080 访问，可改为 0.0.0.0（注意安全）。
NOVNC_BIND=127.0.0.1
NOVNC_PORT=6080

# 手动登录时打开的地址。
MANUAL_LOGIN_URL=https://linux.do/login

# 手动浏览器窗口大小。
SCREEN_WIDTH=1280
SCREEN_HEIGHT=800

# 手动登录容器共享内存大小。
SHM_SIZE=1gb

# ---------------------------------------------------------------------------
# 调试配置
# ---------------------------------------------------------------------------

# 开启后日志更详细；正常运行建议留空。
DEBUG=
